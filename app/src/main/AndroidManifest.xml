<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ds.ide"
    android:versionCode="20213"
    android:versionName="0.2.2-r1">

    <!-- targetSdk 28 is REQUIRED: Android 10+ (W^X) only allows exec of a binary
         from the app data dir when the app targets API <= 28. The pure Bionic
         DeepSeek core and Linux userspace live in files/runtime/bin and files/usr/bin. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
          MainActivity is NOT the launcher: the LAUNCHER intent-filter lives on
          two REAL launcher activities (Duolingo-style dynamic icon). Only one
          is enabled at a time; ThemeManager.applyLauncherIcon() toggles them to
          match the persisted theme. LauncherDarkActivity is enabled by default
          so a fresh install has exactly one launcher entry. Real activities
          (not activity-alias) are required so the OS starting window reads the
          per-theme SplashTheme and the system splash background follows the
          in-app theme instead of the system day/night.
        -->
        <activity
            android:name="com.ds.ide.ui.MainActivity"
            android:exported="false"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- Zero-UI OAuth return trampoline (`deepseek://oauth-success`) so
             Android Chrome immediately returns focus to the DeepSeek task after
             PKCE login instead of staying on an empty browser tab. -->
        <activity
            android:name="com.ds.ide.oauth.OAuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="@string/oauth_scheme"
                    android:host="oauth-success" />
                <data
                    android:scheme="@string/oauth_scheme"
                    android:host="auth-success" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ds.ide.ui.launcher.LauncherDarkActivity"
            android:enabled="true"
            android:exported="true"
            android:theme="@style/SplashThemeDark"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ds.ide.ui.launcher.LauncherLightActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@style/SplashThemeLight"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.ds.ide.runtime.TorchReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ds.ide.ACTION_TORCH" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.ds.ide.core.CoreServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="com.ds.ide.update.UpdateApkProvider"
            android:authorities="com.ds.ide.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
