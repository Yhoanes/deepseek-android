# DeepSeek for Android — host build toolchain defaults.
# Override any variable in the calling shell when building on a custom host.

ANDROID_JAR="${ANDROID_JAR:-$PROJECT/tools/android.jar}"
R8_JAR="${R8_JAR:-$PROJECT/tools/r8.jar}"
KEYSTORE="${KEYSTORE:-${HOME:-.}/.android/debug.keystore}"
KEY_ALIAS="${KEY_ALIAS:-androiddebugkey}"
STORE_PASS="${STORE_PASS:-android}"
KEY_PASS="${KEY_PASS:-android}"
